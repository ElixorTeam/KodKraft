---
import {
  Dialog,
  DialogContent,
  DialogTitle,
  DialogClose
} from "@/shared/ui/dialog";
import AbstractBackground from "@/shared/assets/abstract-bg.webp";
import CallbackForm from "./callback-form.svelte";
import { Image } from "astro:assets";
import KodKraftMiniLogo from "@/shared/assets/mini-logo.svg";
import ShieldAlertIcon from "@lucide/astro/icons/shield-alert";
import PartyPopperIcon from "@lucide/astro/icons/party-popper";
import { Button } from "@/shared/ui/button";
---

<Dialog id="callback-dialog">
  <DialogContent
    class="border-none p-3 text-foreground sm:max-w-md sm:p-0 md:max-w-4xl"
  >
    <div class="grid grid-cols-1 p-3 md:h-160 md:grid-cols-2">
      <div class="relative hidden size-full overflow-hidden md:block">
        <Image
          alt=""
          src={AbstractBackground}
          aria-hidden="true"
          class="size-full rounded-sm object-cover select-none"
        />

        <KodKraftMiniLogo
          class="absolute top-6 left-8 h-9 fill-white"
          aria-hidden="true"
        />

        <div class="absolute bottom-0 p-8 text-white">
          <span class="block pb-2">Попробуйте уже завтра</span>

          <span class="text-2xl font-extrabold">
            Узнайте как проходит урок. Первое занятие - бесплатное.
          </span>
        </div>
      </div>

      <div class="items-center justify-center sm:flex sm:p-10">
        <div class="w-full space-y-3">
          <DialogTitle class="font-medium sm:text-3xl">
            Остались вопросы?<br />
            <div class="mt-1.5 font-semibold">Оставьте заявку</div>
          </DialogTitle>

          <p class="text-sm text-muted-foreground md:pb-4">
            Расскажем о курсах, формате занятий и стоимости — и подберём
            расписание.
          </p>

          <CallbackForm client:only="svelte" />
        </div>
      </div>
    </div>
  </DialogContent>
</Dialog>

<Dialog id="success-dialog">
  <DialogContent class="max-w-sm text-foreground">
    <div class="flex flex-col items-center gap-3">
      <div
        class="flex size-11 items-center justify-center rounded-md bg-primary text-primary-foreground"
      >
        <PartyPopperIcon class="size-7" />
      </div>

      <div class="text-center text-xl font-semibold">Заявка отправлена!</div>

      <div class="text-center text-muted-foreground">
        Спасибо за оформление заявки. <br />
        Мы свяжемся с вами в ближайшее время.
      </div>

      <DialogClose asChild>
        <Button class="mt-4 w-full max-w-3xs"> Понятно </Button>
      </DialogClose>
    </div>
  </DialogContent>
</Dialog>

<Dialog id="error-dialog">
  <DialogContent class="max-w-sm text-foreground">
    <div class="flex flex-col items-center gap-3">
      <div
        class="flex size-11 items-center justify-center rounded-md bg-primary text-primary-foreground"
      >
        <ShieldAlertIcon class="size-7" />
      </div>

      <div class="text-center text-xl font-semibold">Ошибка отправки</div>

      <div class="text-center text-muted-foreground">
        Не удалось отправить форму.<br />
        Повторите попытку позже.
      </div>

      <DialogClose asChild>
        <Button class="mt-4 w-full max-w-3xs"> Понятно </Button>
      </DialogClose>
    </div>
  </DialogContent>
</Dialog>
